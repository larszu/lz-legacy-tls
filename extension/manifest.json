{
  "manifest_version": 3,
  "name": "LZ Legacy TLS",
  "short_name": "Legacy TLS",
  "version": "0.1.0",
  "description": "Opens device web interfaces that only speak TLS 1.0/1.1 or old ciphers, through a small local helper.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging", "storage", "webNavigation"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LZ Legacy TLS",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
